@model List<TARge25Shop.Models.Library.BookIndexViewModel>
@{
    ViewData["Title"] = "Library";
    var readers = ViewBag.Readers as List<TARge25Shop.Models.Library.ReaderIndexViewModel>;
}

<div class="library-box">
    <div class="library-main">
        <h1>Books</h1>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-action="Create" method="post" class="row g-2 mb-3">
            <div class="col-md-4"><input name="Title" class="form-control" placeholder="Title" required /></div>
            <div class="col-md-3"><input name="Author" class="form-control" placeholder="Author" required /></div>
            <div class="col-md-3"><input name="PublishedYear" type="number" class="form-control" placeholder="Year" required /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100">Add</button></div>
        </form>

        <form asp-action="ByTitle" method="get" class="row g-2 mb-3">
            <div class="col-md-4"><input name="title" class="form-control" placeholder="Search by title" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100">Search</button></div>
            <div class="col-md-4"><input name="year" type="number" class="form-control" placeholder="Search by year" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" formaction="@Url.Action("ByYear")">Search</button></div>
        </form>

        <input id="bookSearch" class="form-control mb-3" placeholder="Type to filter books..." />

        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Title</th><th>Author</th><th>Year</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.PublishedYear</td>
                        <td>
                            @if (book.IsAvailable)
                            {
                                <span class="status status-ok">Available</span>
                            }
                            else
                            {
                                <span class="status status-out">Borrowed</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (book.IsAvailable)
                            {
                                <form asp-action="Borrow" method="post" class="d-inline-flex gap-1">
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <select name="readerId" class="form-control form-control-sm" required>
                                        <option value="">Reader...</option>
                                        @foreach (var r in readers)
                                        {
                                            <option value="@r.Id">@r.FullName</option>
                                        }
                                    </select>
                                    <button class="btn btn-success btn-sm">Borrow</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Return" method="post" class="d-inline">
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <button class="btn btn-warning btn-sm">Return</button>
                                </form>
                            }
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@book.Id" />
                                <button class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p>No books here yet.</p>
        }
    </div>

    <div class="library-menu">
        <h2>Library</h2>
        <a asp-action="Index">All books</a>
        <a asp-action="Borrowed">Borrowed</a>
        <a asp-action="Readers">Readers</a>
    </div>
</div>