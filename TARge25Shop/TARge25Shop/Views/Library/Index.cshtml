@{
    ViewData["Title"] = "Library";
}

<div style="background-color: #0d131a; color: white; display: flex; padding: 20px;">
    <div style="flex: 1;">
        <span style="color: gray; font-size: 10px;">CULTURE MAR 20</span>
        <h1 style="font-family: serif; font-size: 40px;">The Saddest Book</h1>
        <p style="color: #ccc;">Library</p>
        
        <hr style="border-color: #333;">

        <div style="margin-top: 20px;">
            <p style="color: gray; font-size: 10px;">CULTURE APR 02</p>
            <h3>Unfair trade</h3>
        </div>

        <div style="margin-top: 20px;">
            <p style="color: gray; font-size: 10px;">POWER APR 02</p>
            <h3>An open letter to a dog, who won't come out from under the couch</h3>
        </div>
    </div>

    <div style="width: 350px; background-color: #ff2a55; padding: 30px; text-align: center;">
        <span style="float: right; font-size: 24px; cursor: pointer;">×</span>
        
        <h2 style="font-family: serif; font-size: 30px; color: black; margin-top: 20px;">The Outline</h2>

        <div style="margin: 30px 0; display: flex; flex-direction: column; gap: 10px;">
            <div style="background-color: black; color: #ff2a55; padding: 15px; font-size: 24px; font-weight: bold;">RECENT</div>
            <div style="background-color: black; color: #ff2a55; padding: 15px; font-size: 24px; font-weight: bold;">POWER</div>
            <div style="background-color: white; color: #ff2a55; padding: 15px; font-size: 24px; font-weight: bold;">CULTURE</div>
            <div style="background-color: black; color: #ff2a55; padding: 15px; font-size: 24px; font-weight: bold;">FUTURE</div>
        </div>

        <div style="font-size: 10px; color: black; font-weight: bold; margin-top: 50px;">
            ABOUT &nbsp; LEGAL &nbsp; JOBS &nbsp; GOT A TIP?
        </div>
    </div>
</div>