@model List<TARge25Shop.Models.Library.ReaderIndexViewModel>
@{
    ViewData["Title"] = "Readers";
}

<div class="page-header">
    <div>
        <h1>Readers</h1>
        <p class="page-sub">@Model.Count in the library</p>
    </div>
    <a asp-action="Index" class="btn btn-light btn-sm">← Back to books</a>
</div>

<form asp-action="CreateReader" method="post" class="add-form">
    <input name="FullName" class="form-control" placeholder="Full name" required />
    <input name="Email" type="email" class="form-control" placeholder="Email" required />
    <button class="btn btn-primary">Add reader</button>
</form>

@if (!Model.Any())
{
    <p class="empty-text">No readers yet. Add the first one above.</p>
}
else
{
    <div class="reader-list">
        @foreach (var reader in Model)
        {
            <div class="reader-row">
                <span class="avatar">@(reader.FullName.Length > 0 ? reader.FullName.Substring(0, 1).ToUpper() : "?")</span>

                <div class="reader-info">
                    <b>@reader.FullName</b>
                    <span>@reader.Email</span>
                </div>

                <a asp-action="Loans" asp-route-readerId="@reader.Id" class="btn btn-outline-primary btn-sm">Loans</a>
            </div>
        }
    </div>
}