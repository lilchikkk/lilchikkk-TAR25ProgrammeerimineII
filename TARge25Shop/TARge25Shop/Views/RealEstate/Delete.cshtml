@model TARge25Shop.Models.RealEstate.RealEstateDeleteViewModel

@{
    ViewData["Title"] = "Delete real estate";
}

<div class="theme-blue">
    <div class="panel panel-danger narrow">
        <div class="text-center">
            <div class="empty-emoji">⚠️</div>
            <h1>Delete real estate?</h1>
            <p class="text-muted">This action cannot be undone.</p>
        </div>

        <div class="info-grid single">
            <div class="info-item"><span>Location</span><strong>📍 @Model.Location</strong></div>
            <div class="info-item"><span>Area</span><strong>📐 @Model.Area m²</strong></div>
            <div class="info-item"><span>Rooms</span><strong>🛏 @Model.RoomNumber</strong></div>
            <div class="info-item"><span>Building type</span><strong>🏢 @Model.BuildingType</strong></div>
            <div class="info-item"><span>Created at</span><strong>@(Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong></div>
            <div class="info-item"><span>Modified at</span><strong>@(Model.ModifiedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong></div>
        </div>

        <form asp-action="DeleteConfirmation" class="mt-4 d-flex gap-2 justify-content-center">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Yes, delete" class="btn btn-danger" />
            <a asp-action="Index" asp-controller="realEstate" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>