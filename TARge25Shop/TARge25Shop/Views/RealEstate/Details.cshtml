@model TARge25Shop.Models.RealEstate.RealEstateDetailsViewModel

@{
    ViewData["Title"] = "Real estate details";
}

<div class="theme-blue">
    <div class="page-header">
        <h1>🏠 @Model.Location</h1>
    </div>

    <div class="panel">
        <div class="info-grid">
            <div class="info-item"><span>Location</span><strong>📍 @Model.Location</strong></div>
            <div class="info-item"><span>Area</span><strong>📐 @Model.Area m²</strong></div>
            <div class="info-item"><span>Rooms</span><strong>🛏 @Model.RoomNumber</strong></div>
            <div class="info-item"><span>Building type</span><strong>🏢 @Model.BuildingType</strong></div>
            <div class="info-item"><span>Created at</span><strong>@(Model.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong></div>
            <div class="info-item"><span>Modified at</span><strong>@(Model.ModifiedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</strong></div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="update" asp-controller="realEstate" asp-route-id="@Model.Id" class="btn btn-warning">Update</a>
            <a asp-action="Index" asp-controller="realEstate" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>