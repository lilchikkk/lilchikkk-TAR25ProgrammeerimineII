@model TARge25Shop.Models.RealEstate.RealEstateCreateUpdateViewModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Update real estate" : "Create real estate";
}

<div class="theme-blue">
    <div class="page-header">
        <h1>@(Model.Id.HasValue ? "✏️ Update real estate" : "✨ Create real estate")</h1>
    </div>

    <div class="panel narrow">
        <form method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="ModifiedAt" type="hidden" />

            <div class="mb-3">
                <label asp-for="Area" class="form-label">Area (m²)</label>
                <input asp-for="Area" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="RoomNumber" class="form-label">Room number</label>
                <input asp-for="RoomNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="BuildingType" class="form-label">Building type</label>
                <input asp-for="BuildingType" class="form-control" />
            </div>

            <hr />

            <div class="d-flex gap-2">
                @if (Model.Id.HasValue)
                {
                    <input asp-action="update" asp-controller="realEstate" type="submit" class="btn btn-success" value="Update" />
                }
                else
                {
                    <input asp-action="create" asp-controller="realEstate" type="submit" class="btn btn-success" value="Create" />
                }

                <a asp-action="Index" asp-controller="realEstate" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>