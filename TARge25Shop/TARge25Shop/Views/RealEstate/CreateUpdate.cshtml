@model TARge25Shop.Models.RealEstate.RealEstateCreateUpdateViewModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Update real estate" : "Create real estate";
}

<div class="theme-blue">
    <div class="page-header">
        <h1>@(Model.Id.HasValue ? "✏️ Update real estate" : "✨ Create real estate")</h1>
    </div>

    <div class="panel narrow">
        <form method="post" enctype="multipart/form-data" asp-action="@(Model.Id.HasValue ? "Update" : "Create")">
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="ModifiedAt" type="hidden" />

            <div class="mb-3">
                <label asp-for="Area" class="form-label">Area (m²)</label>
                <input asp-for="Area" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="RoomNumber" class="form-label">Room number</label>
                <input asp-for="RoomNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="BuildingType" class="form-label">Building type</label>
                <input asp-for="BuildingType" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Files" class="form-label">Images</label>
                <input asp-for="Files" type="file" multiple class="form-control" />
            </div>

            <hr />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    @(Model.Id.HasValue ? "Update" : "Create")
                </button>
                <a asp-action="Index" asp-controller="RealEstate" class="btn btn-secondary">Back to List</a>
            </div>
        </form>

        @if (Model.Image != null && Model.Image.Any())
        {
            <hr />
            <h5>Saved images</h5>
            <div class="row">
                @foreach (var img in Model.Image)
                {
                    <div class="col-md-3 mb-3 text-center">
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(img.ImageData)"
                             alt="@img.ImageTitle"
                             class="img-thumbnail mb-2"
                             style="max-height: 150px; object-fit: cover;" />

                        <form asp-action="RemoveImage" asp-controller="RealEstate" method="post">
                            <input type="hidden" name="imageId" value="@img.ImageId" />
                            <input type="hidden" name="realEstateId" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>