@model TARge25Shop.Models.Kindergarten.KindergartenDeleteViewModel

@{
    ViewData["Title"] = "Delete kindergarten";
}

<div class="panel panel-danger narrow">
    <div class="text-center">
        <div class="empty-emoji">⚠️</div>
        <h1>Delete kindergarten?</h1>
        <p class="text-muted">This action cannot be undone.</p>
    </div>

    <div class="info-grid single">
        <div class="info-item"><span>Group name</span><strong>@Model.GroupName</strong></div>
        <div class="info-item"><span>Children count</span><strong>👶 @Model.ChildrenCount</strong></div>
        <div class="info-item"><span>Kindergarten name</span><strong>🏫 @Model.KindergartenName</strong></div>
        <div class="info-item"><span>Teacher name</span><strong>👩‍🏫 @Model.TeacherName</strong></div>
        <div class="info-item"><span>Created at</span><strong>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</strong></div>
        <div class="info-item"><span>Updated at</span><strong>@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</strong></div>
    </div>

    @if (Model.Image.Any())
    {
        <div class="gallery mt-3">
            @foreach (var image in Model.Image)
            {
                <partial name="_Images" model="image" />
            }
        </div>
    }

    <form asp-action="DeleteConfirmation" method="post" class="mt-4 d-flex gap-2 justify-content-center">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger">Yes, delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>