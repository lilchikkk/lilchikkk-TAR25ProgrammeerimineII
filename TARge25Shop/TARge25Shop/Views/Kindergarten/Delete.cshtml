@model TARge25Shop.Models.Kindergarten.KindergartenDeleteViewModel

@{
    ViewData["Title"] = "Delete kindergarten";
}

<h1>Delete kindergarten</h1>

<h3>Are you sure you want to delete this kindergarten?</h3>

<dl class="row">
    <dt class="col-sm-3">Group name</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>

    <dt class="col-sm-3">Children count</dt>
    <dd class="col-sm-9">@Model.ChildrenCount</dd>

    <dt class="col-sm-3">Kindergarten name</dt>
    <dd class="col-sm-9">@Model.KindergartenName</dd>

    <dt class="col-sm-3">Teacher name</dt>
    <dd class="col-sm-9">@Model.TeacherName</dd>

    <dt class="col-sm-3">Created at</dt>
    <dd class="col-sm-9">@Model.CreatedAt</dd>

    <dt class="col-sm-3">Updated at</dt>
    <dd class="col-sm-9">@Model.UpdatedAt</dd>
</dl>

<form asp-action="DeleteConfirmation" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>