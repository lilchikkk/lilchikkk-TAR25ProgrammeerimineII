@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergartens";
}

<div class="page-header">
    <div>
        <h1>🧸 Kindergartens</h1>
        <p class="text-muted mb-0">Total groups: <strong>@Model.Count()</strong></p>
    </div>
    <a asp-action="CreateUpdate" class="btn btn-primary">+ Create new</a>
</div>

<input type="text" id="searchInput" class="form-control search-box"
       placeholder="🔍 Search by group, kindergarten or teacher..." />

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-emoji">🪁</div>
        <h3>No kindergartens yet</h3>
        <p>Click “Create new” to add the first one.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var kindergarten in Model)
        {
            <div class="col-sm-6 col-lg-4 kg-item">
                <div class="kg-card">
                    <div class="kg-top">
                        <span class="kg-avatar">@(kindergarten.GroupName.Length > 0 ? kindergarten.GroupName.Substring(0, 1).ToUpper() : "?")</span>
                        <strong>👶 @kindergarten.ChildrenCount</strong>
                    </div>
                    <div class="kg-body">
                        <h3 class="kg-title">@kindergarten.GroupName</h3>
                        <p class="kg-line">🏫 @kindergarten.KindergartenName</p>
                        <p class="kg-line">👩‍🏫 @kindergarten.TeacherName</p>
                        <p class="kg-date">Created: @kindergarten.CreatedAt.ToString("dd.MM.yyyy")</p>
                    </div>
                    <div class="kg-actions">
                        <a asp-action="Details" asp-route-id="@kindergarten.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@kindergarten.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@kindergarten.Id" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <p id="noResults" class="text-center text-muted mt-4" style="display:none;">Nothing found 😕</p>
}