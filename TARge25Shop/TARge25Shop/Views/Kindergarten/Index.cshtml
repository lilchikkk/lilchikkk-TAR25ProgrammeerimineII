@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>

@{
    ViewData["Title"] = "Kindergartens";
    int rowNumber = 1;
}

<h1>Kindergartens</h1>

<p>
    <a asp-action="CreateUpdate" class="btn btn-primary">
        Create new
    </a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nr</th>
            <th>Group name</th>
            <th>Children count</th>
            <th>Kindergarten name</th>
            <th>Teacher name</th>
            <th>Created at</th>
            <th>Updated at</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var kindergarten in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@kindergarten.GroupName</td>
                <td>@kindergarten.ChildrenCount</td>
                <td>@kindergarten.KindergartenName</td>
                <td>@kindergarten.TeacherName</td>
                <td>@kindergarten.CreatedAt</td>
                <td>@kindergarten.UpdatedAt</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@kindergarten.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@kindergarten.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@kindergarten.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>

            rowNumber++;
        }
    </tbody>
</table>