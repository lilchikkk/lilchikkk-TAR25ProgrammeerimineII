@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <h1 class="hero-title">chill out</h1>
    <p class="hero-tag">library &amp; more</p>

    <a asp-controller="Library" asp-action="Index" class="btn btn-light btn-lg">Open library</a>
    <a asp-controller="Library" asp-action="Readers" class="btn btn-light btn-lg">Readers</a>
</section>

<section class="row g-4 mt-2">
    <div class="col-md-3">
        <a asp-controller="Library" asp-action="Index" class="feature-card">
            <span class="feature-icon">📚</span>
            <h3>Library</h3>
            <p>Books, readers and loans.</p>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Kindergarten" asp-action="Index" class="feature-card">
            <span class="feature-icon">🧸</span>
            <h3>Kindergarten</h3>
            <p>Groups and teachers.</p>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Spaceship" asp-action="Index" class="feature-card">
            <span class="feature-icon">🚀</span>
            <h3>Spaceship</h3>
            <p>Your fleet of ships.</p>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="RealEstate" asp-action="Index" class="feature-card">
            <span class="feature-icon">🏠</span>
            <h3>Real estate</h3>
            <p>Houses and flats.</p>
        </a>
    </div>
</section>