@model TARge25Shop.Models.Spaceship.SpaceshipDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="space">
    <h1 class="h2 mb-3">Details</h1>

    <div class="box">
        <h4>@Model.Name</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.ShipType</dd>

            <dt class="col-sm-3">Crew</dt>
            <dd class="col-sm-9">@Model.Crew</dd>

            <dt class="col-sm-3">Engine power</dt>
            <dd class="col-sm-9">@Model.EnginePower</dd>

            <dt class="col-sm-3">Created at</dt>
            <dd class="col-sm-9">@Model.CreatedAt</dd>

            <dt class="col-sm-3">Updated at</dt>
            <dd class="col-sm-9">@Model.UpdatedAt</dd>
        </dl>

        <div class="row">
            @foreach (var images in Model.Image)
            {
                <div class="col-md-4 mb-3">
                    <partial name="_Images" model="images" />
                </div>
            }
        </div>

        <a asp-action="Index" asp-controller="Spaceship" class="btn btn-outline-light">Back</a>
    </div>
</div>