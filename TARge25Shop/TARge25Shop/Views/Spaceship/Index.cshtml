@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

@{
    ViewData["Title"] = "Spaceships";
    short rowNumber = 1;
}

<div class="space">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 mb-0">Spaceships</h1>
        <a asp-action="Create" asp-controller="Spaceship" class="btn btn-primary">Create</a>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <input id="tableSearch" class="form-control" placeholder="Search by name, type, crew..." />
        </div>
        <div class="col-md-4">
            <select id="typeFilter" class="form-select">
                <option value="">All types</option>
            </select>
        </div>
    </div>

    <div class="box">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Built Date</th>
                    <th>Crew</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spaceship in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@spaceship.Name</td>
                        <td class="ship-type">@spaceship.ShipType</td>
                        <td>@spaceship.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>@spaceship.Crew</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-light">Details</a>
                            <a asp-action="Update" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-info">Update</a>
                            <a asp-action="Delete" asp-controller="Spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                    rowNumber += 1;
                }
            </tbody>
        </table>
    </div>
</div>