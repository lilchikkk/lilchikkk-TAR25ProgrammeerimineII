@model TARge25Shop.Models.Spaceship.SpaceshipCreateUpdateViewModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Update" : "Create";
}

<div class="space">
    <h1 class="h2 mb-3">@ViewData["Title"]</h1>

    <form method="post" enctype="multipart/form-data" class="box">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="UpdatedAt" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ShipType" class="form-label"></label>
            <input asp-for="ShipType" class="form-control" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Crew" class="form-label"></label>
                <input asp-for="Crew" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EnginePower" class="form-label"></label>
                <input asp-for="EnginePower" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Files" class="form-label"></label>
            <input asp-for="Files" class="form-control" multiple type="file" />
        </div>

        <div class="row" id="preview"></div>

        <div class="row">
            @foreach (var images in Model.Image)
            {
                <div class="col-md-4 mb-3">
                    <partial name="_Images" model="images" />
                    <input asp-action="removeImage" asp-controller="spaceship" asp-route-imageId="@images.ImageId"
                           type="submit" class="btn btn-sm btn-danger mt-2" value="Remove Image" />
                </div>
            }
        </div>

        <hr />

        @if (Model.Id.HasValue)
        {
            <input asp-action="update" asp-controller="spaceship" type="submit" class="btn btn-primary" value="Update" />
        }
        else
        {
            <input asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary" value="Create" />
        }

        <a asp-action="Index" asp-controller="spaceship" class="btn btn-outline-light">Back to List</a>
    </form>
</div>